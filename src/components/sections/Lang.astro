---
import Section from "../Section.astro";

import { languages } from "@cv";
---

<Section className={Astro.props.className} title="Languages">
  <ul class="space-y-4 py-3">
    {
      languages.map(({ language, fluency }) => {
        return (
          <div class="flex items-baseline">
            <div class="relative w-full items-baseline justify-between gap-2">
              <h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
                <a target="_blank" rel="noopener noreferrer">{language}</a>
              </h3>
              <div class="text-sm text-skin-muted">{fluency}</div>
            </div>
          </div>
        );
      })
    }
  </ul>
</Section>
